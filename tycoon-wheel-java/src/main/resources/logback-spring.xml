<?xml version="1.0" encoding="UTF-8"?>
<!--
  统一日志格式：把 SkyWalking 的 traceId 打进日志，用于「traceID → 日志」定位。
  用 apm-toolkit-logback-1.x 提供的 TraceIdPatternLogbackLayout + %tid 转换器。
  （普通 %X{tid} 读的是 MDC，SkyWalking 默认不写 MDC，所以为空）
-->
<configuration>

    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%tid] [%thread] %logger{40} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
            <charset>UTF-8</charset>
            <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.TraceIdPatternLogbackLayout">
                <pattern>${LOG_PATTERN}</pattern>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
