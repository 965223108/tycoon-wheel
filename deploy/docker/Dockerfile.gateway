FROM eclipse-temurin:21-jre-alpine

ARG WITH_AGENT=true

RUN apk add --no-cache tzdata curl wget && \
    cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app
COPY gateway.jar /app/gateway.jar

# SkyWalking Java Agent（可选，由 SW_AGENT_ENABLED 控制）
COPY skywalking-agent/ /app/skywalking-agent/

# 启用 optional-plugins 里网关必需的插件（默认不激活，不启用就没有任何流量指标）
RUN set -eux; \
    for p in apm-spring-cloud-gateway-4.x apm-spring-webflux-6.x apm-nacos-client-2.x; do \
      cp /app/skywalking-agent/optional-plugins/${p}-plugin-*.jar /app/skywalking-agent/plugins/ 2>/dev/null || true; \
    done; \
    ls /app/skywalking-agent/plugins/ | grep -E 'gateway|webflux|nacos' | sed 's/^/enabled: /'

ENV JAVA_OPTS="-XX:MaxRAMPercentage=65 -XX:+UseG1GC -Xss512k -Duser.timezone=Asia/Shanghai" \
    SW_AGENT_ENABLED=false \
    SW_AGENT_NAME=tycoon-gateway \
    SW_AGENT_COLLECTOR=skywalking-oap:11800

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "if [ \"$SW_AGENT_ENABLED\" = \"true\" ] && [ -f /app/skywalking-agent/skywalking-agent.jar ]; then exec java $JAVA_OPTS -javaagent:/app/skywalking-agent/skywalking-agent.jar -Dskywalking.agent.service_name=$SW_AGENT_NAME -Dskywalking.collector.backend_service=$SW_AGENT_COLLECTOR -jar /app/gateway.jar; else exec java $JAVA_OPTS -jar /app/gateway.jar; fi"]
