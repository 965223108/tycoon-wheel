<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.tycoon.admin.mapper.AdminUserMapper">

    <resultMap id="adminMap" type="com.tycoon.admin.domain.AdminUser">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="salt" property="salt"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="role" property="role"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <select id="findByUsername" resultMap="adminMap">
        SELECT id, username, salt, password_hash, role, created_at
        FROM admin_users WHERE username = #{username} LIMIT 1
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM admin_users
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO admin_users (username, salt, password_hash, role, created_at)
        VALUES (#{username}, #{salt}, #{passwordHash}, #{role}, UTC_TIMESTAMP(3))
    </insert>

</mapper>
